<div class="py-2">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-white bebas">Mis Reseñas</h1>
        <p class="text-gray-500 text-sm mt-1">Comparte tu experiencia</p>
    </div>

    <!-- Write review form -->
    <div class="rounded-xl p-5 border border-white/10 mb-6" style="background:#0d0d0d;">
        <h2 class="font-semibold text-white mb-4">Nueva reseña</h2>
        <div class="flex gap-2 mb-4" id="star-picker">
            <i class="fa-regular fa-star fa-2x cursor-pointer text-gray-600 star-btn" data-val="1" onclick="pickStar(1)"></i>
            <i class="fa-regular fa-star fa-2x cursor-pointer text-gray-600 star-btn" data-val="2" onclick="pickStar(2)"></i>
            <i class="fa-regular fa-star fa-2x cursor-pointer text-gray-600 star-btn" data-val="3" onclick="pickStar(3)"></i>
            <i class="fa-regular fa-star fa-2x cursor-pointer text-gray-600 star-btn" data-val="4" onclick="pickStar(4)"></i>
            <i class="fa-regular fa-star fa-2x cursor-pointer text-gray-600 star-btn" data-val="5" onclick="pickStar(5)"></i>
        </div>
        <textarea id="review-text" class="form-control mb-3" rows="3" placeholder="Cuéntanos tu experiencia..."></textarea>
        <button class="btn btn-gold w-full rounded-pill" onclick="submitReview()">
            <i class="fa-solid fa-paper-plane me-2"></i> Publicar reseña
        </button>
    </div>

    <!-- My reviews list -->
    <div id="my-reviews" class="flex flex-col gap-3"></div>
</div>
<script src="/js/app/reviews.js"></script>
