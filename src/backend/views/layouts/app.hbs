<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Cuenta | HighQuality Studio</title>
    <meta name="user-name" content="{{user.name}}">
    <link rel="shortcut icon" type="image/x-icon" href="/images/simple-logo.png">

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#111111">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&family=The+Nautigal:wght@400;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="/css/tailwind.css">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="/fonts/icons/free/css/all.css">
    <link rel="stylesheet" href="/fonts/icons/pro/css/all.css">

    <!-- Animate.css -->
    <link rel="stylesheet" href="/scripts/animate.css/animate.min.css">

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="/scripts/sweetalert2/dist/sweetalert2.min.css">

    <!-- Moment.js -->
    <script src="/scripts/moment/min/moment.min.js"></script>
    <script src="/scripts/moment/locale/es.js"></script>

    <!-- Axios -->
    <script src="/scripts/axios/dist/axios.min.js"></script>

    <!-- SweetAlert2 JS -->
    <script src="/scripts/sweetalert2/dist/sweetalert2.min.js"></script>

    <!-- Modal + Bootstrap compat shim -->
    <script>
        (function() {
            window.bootstrap = window.bootstrap || {};
            window.bootstrap.Modal = function(el, opts) {
                var elem = typeof el === 'string' ? document.querySelector(el) : el;
                return {
                    show: function() {
                        if (!elem) return;
                        elem.classList.add('modal-open');
                        document.body.style.overflow = 'hidden';
                    },
                    hide: function() {
                        if (!elem) return;
                        elem.classList.remove('modal-open');
                        document.body.style.overflow = '';
                    }
                };
            };
            window.bootstrap.Modal.getInstance = function(el) {
                var elem = typeof el === 'string' ? document.querySelector(el) : el;
                return window.bootstrap.Modal(elem);
            };
            document.addEventListener('click', function(e) {
                var dismiss = e.target.closest('[data-bs-dismiss]');
                if (dismiss) {
                    var modal = dismiss.closest('.modal');
                    if (modal) { modal.classList.remove('modal-open'); document.body.style.overflow = ''; }
                }
                var toggle = e.target.closest('[data-bs-toggle="modal"]');
                if (toggle) {
                    var target = document.querySelector(toggle.getAttribute('data-bs-target'));
                    if (target) { target.classList.add('modal-open'); document.body.style.overflow = 'hidden'; }
                }
                if (e.target.classList && e.target.classList.contains('modal') && e.target.classList.contains('modal-open')) {
                    e.target.classList.remove('modal-open');
                    document.body.style.overflow = '';
                }
            });
        })();
    </script>
</head>
<body class="inter" style="background:#111111; color:#f1f1f1;">

    <!-- Client app header -->
    <header style="background:#0d0d0d; border-bottom:1px solid rgba(255,255,255,0.08);">
        <div class="flex items-center justify-between px-4 py-3 max-w-2xl mx-auto">
            <div class="flex items-center gap-3">
                <a href="/" class="text-gray-500 hover:text-white text-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i> Inicio
                </a>
                <span class="text-gray-700">|</span>
                <span class="text-white font-semibold text-sm">{{user.name}}</span>
            </div>
            <nav class="flex items-center gap-3">
                <a href="/app" class="text-sm {{#if isApp}}text-gold font-semibold{{else}}text-gray-400 hover:text-white{{/if}}">
                    <i class="fa-solid fa-house"></i>
                </a>
                <a href="/app/history" class="text-sm {{#if isHistory}}text-gold font-semibold{{else}}text-gray-400 hover:text-white{{/if}}">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i> Historial
                </a>
                <a href="/app/reviews" class="text-sm {{#if isReviews}}text-gold font-semibold{{else}}text-gray-400 hover:text-white{{/if}}">
                    <i class="fa-solid fa-star me-1"></i> Reseñas
                </a>
                <button onclick="logoutUser()" class="text-xs text-gray-600 hover:text-red-400 btn btn-sm btn-dark ms-2">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </button>
            </nav>
        </div>
    </header>

    <main class="max-w-2xl mx-auto px-4 py-6">
        {{{body}}}
    </main>

    <!-- Alpine.js -->
    <script defer src="/scripts/alpinejs/dist/cdn.min.js"></script>

    <script>
    async function logoutUser() {
        await axios.post('/api/v1/auth/logout');
        window.location.href = '/';
    }
    // Legacy alias
    var logoutClient = logoutUser;
    moment.locale('es');
    </script>
</body>
</html>
