<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Cuenta | HighQuality Studio</title>
    <meta name="user-name" content="{{user.name}}">
    <link rel="shortcut icon" type="image/x-icon" href="/images/simple-logo.png">

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#111111">

    <!-- Google Fonts -->
    <link rel="preload" href="/fonts/hq/bebas-neue.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/hq/inter-var.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/fonts/hq/fonts.css">

    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="/css/tailwind.css">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="/fonts/icons/free/css/all.css">
    <link rel="stylesheet" href="/fonts/icons/pro/css/all.css">

    <!-- Animate.css -->
    <link rel="stylesheet" href="/scripts/animate.css/animate.min.css">

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="/scripts/sweetalert2/dist/sweetalert2.min.css">

    <!-- Moment.js -->
    <script src="/scripts/moment/min/moment.min.js"></script>
    <script src="/scripts/moment/locale/es.js"></script>

    <!-- Axios -->
    <script src="/scripts/axios/dist/axios.min.js"></script>
    <script src="/js/app/common.js"></script>

    <!-- SweetAlert2 JS -->
    <script src="/scripts/sweetalert2/dist/sweetalert2.min.js"></script>

    <!-- Modal + Bootstrap compat shim -->
    <script>
        (function() {
            window.bootstrap = window.bootstrap || {};
            window.bootstrap.Modal = function(el, opts) {
                var elem = typeof el === 'string' ? document.querySelector(el) : el;
                return {
                    show: function() {
                        if (!elem) return;
                        elem.classList.add('modal-open');
                        document.body.style.overflow = 'hidden';
                    },
                    hide: function() {
                        if (!elem) return;
                        elem.classList.remove('modal-open');
                        document.body.style.overflow = '';
                    }
                };
            };
            window.bootstrap.Modal.getInstance = function(el) {
                var elem = typeof el === 'string' ? document.querySelector(el) : el;
                return window.bootstrap.Modal(elem);
            };
            document.addEventListener('click', function(e) {
                var dismiss = e.target.closest('[data-bs-dismiss]');
                if (dismiss) {
                    var modal = dismiss.closest('.modal');
                    if (modal) { modal.classList.remove('modal-open'); document.body.style.overflow = ''; }
                }
                var toggle = e.target.closest('[data-bs-toggle="modal"]');
                if (toggle) {
                    var target = document.querySelector(toggle.getAttribute('data-bs-target'));
                    if (target) { target.classList.add('modal-open'); document.body.style.overflow = 'hidden'; }
                }
                if (e.target.classList && e.target.classList.contains('modal') && e.target.classList.contains('modal-open')) {
                    e.target.classList.remove('modal-open');
                    document.body.style.overflow = '';
                }
            });
        })();
    </script>
</head>
<body class="inter acc-body">

    <!-- Top bar: who is signed in, way back to the site, sign out -->
    <header class="acc-top">
        <div class="acc-wrap acc-top-in">
            <span class="acc-avatar" id="acc-avatar" aria-hidden="true"></span>
            <div class="acc-who">
                <small>Mi cuenta</small>
                <strong>{{user.name}}</strong>
            </div>
            <a href="/" class="acc-iconbtn" aria-label="Volver al sitio" title="Volver al sitio">
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </a>
            <button type="button" onclick="logoutUser()" class="acc-iconbtn danger" aria-label="Cerrar sesión" title="Cerrar sesión">
                <i class="fa-solid fa-right-from-bracket"></i>
            </button>
        </div>
    </header>

    <main class="acc-wrap acc-main">
        {{{body}}}
    </main>

    <!-- Bottom dock: thumb-reach navigation, the active pill slides between pages -->
    <nav class="acc-dock" aria-label="Mi cuenta">
        <a href="/app" class="acc-tab" {{#if isApp}}aria-current="page"{{/if}}>
            {{#if isApp}}<span class="acc-pill"></span>{{/if}}
            <i class="fa-solid fa-house"></i><span>Inicio</span>
        </a>
        <a href="/app/history" class="acc-tab" {{#if isHistory}}aria-current="page"{{/if}}>
            {{#if isHistory}}<span class="acc-pill"></span>{{/if}}
            <i class="fa-solid fa-clock-rotate-left"></i><span>Historial</span>
        </a>
        <a href="/app/reviews" class="acc-tab" {{#if isReviews}}aria-current="page"{{/if}}>
            {{#if isReviews}}<span class="acc-pill"></span>{{/if}}
            <i class="fa-solid fa-star"></i><span>Reseñas</span>
        </a>
    </nav>

    <!-- Alpine.js -->
    <script defer src="/scripts/alpinejs/dist/cdn.min.js"></script>

    <script>
    moment.locale('es');
    (function () {
        var n = (document.querySelector('meta[name="user-name"]') || {}).content || '';
        document.getElementById('acc-avatar').textContent = (n.trim().charAt(0) || '?').toUpperCase();
    })();

    async function logoutUser() {
        const ok = await Swal.fire({
            title: '¿Cerrar sesión?', text: 'Tendrás que volver a ingresar para ver tus citas.',
            showCancelButton: true, confirmButtonText: 'Cerrar sesión', cancelButtonText: 'Cancelar',
            confirmButtonColor: '#F4C82C', background: '#0d0d0d', color: '#f1f1f1', reverseButtons: true,
        });
        if (!ok.isConfirmed) return;
        await axios.post('/api/v1/auth/logout');
        window.location.href = '/';
    }
    // Legacy alias
    var logoutClient = logoutUser;
    </script>
</body>
</html>
