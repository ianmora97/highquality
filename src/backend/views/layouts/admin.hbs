<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - HighQuality Studio</title>
    <link rel="shortcut icon" type="image/x-icon" href="/images/favicon/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="128x128" href="/images/favicon/apple-touch-icon.png">
    <meta name="robots" content="noindex, nofollow">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#111111">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&family=The+Nautigal:wght@400;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="/css/tailwind.css">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="/fonts/icons/free/css/all.css">
    <link rel="stylesheet" href="/fonts/icons/pro/css/all.css">

    <!-- Animate.css -->
    <link rel="stylesheet" href="/scripts/animate.css/animate.min.css">

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="/scripts/sweetalert2/dist/sweetalert2.min.css">

    <!-- Alpine.js -->
    <script defer src="/scripts/alpinejs/dist/cdn.min.js"></script>

    <!-- jQuery -->
    <script src="/scripts/jquery/dist/jquery.min.js"></script>

    <!-- Moment.js -->
    <script src="/scripts/moment/min/moment.min.js"></script>
    <script src="/scripts/moment/locale/es.js"></script>

    <!-- Anime.js -->
    <script src="/scripts/animejs/lib/anime.min.js"></script>

    <!-- Axios -->
    <script src="/scripts/axios/dist/axios.min.js"></script>

    <!-- SweetAlert2 JS -->
    <script src="/scripts/sweetalert2/dist/sweetalert2.min.js"></script>

    <!-- Modal + Bootstrap compat shim -->
    <script>
        (function() {
            window.bootstrap = window.bootstrap || {};
            window.bootstrap.Modal = function(el, opts) {
                var elem = typeof el === 'string' ? document.querySelector(el) : el;
                return {
                    show: function() {
                        if (!elem) return;
                        elem.classList.add('modal-open');
                        document.body.style.overflow = 'hidden';
                    },
                    hide: function() {
                        if (!elem) return;
                        elem.classList.remove('modal-open');
                        document.body.style.overflow = '';
                    }
                };
            };
            window.bootstrap.Modal.getInstance = function(el) {
                var elem = typeof el === 'string' ? document.querySelector(el) : el;
                return window.bootstrap.Modal(elem);
            };

            document.addEventListener('click', function(e) {
                var dismiss = e.target.closest('[data-bs-dismiss]');
                if (dismiss) {
                    var modal = dismiss.closest('.modal');
                    if (modal) { modal.classList.remove('modal-open'); document.body.style.overflow = ''; }
                }
                var toggle = e.target.closest('[data-bs-toggle="modal"]');
                if (toggle) {
                    var target = document.querySelector(toggle.getAttribute('data-bs-target'));
                    if (target) { target.classList.add('modal-open'); document.body.style.overflow = 'hidden'; }
                }
                if (e.target.classList && e.target.classList.contains('modal') && e.target.classList.contains('modal-open')) {
                    e.target.classList.remove('modal-open');
                    document.body.style.overflow = '';
                }
            });

            // jQuery plugin compat (jQuery already loaded before this script)
            if (window.jQuery) {
                jQuery.fn.modal = function(action) {
                    var el = this[0];
                    if (!el) return this;
                    if (action === 'show') { el.classList.add('modal-open'); document.body.style.overflow = 'hidden'; }
                    else if (action === 'hide') { el.classList.remove('modal-open'); document.body.style.overflow = ''; }
                    return this;
                };
            }
        })();
    </script>
</head>
<body class="overflow-x-hidden inter" style="background-color:#141414; color:#f1f1f1;">
    {{>admin/header}}
    <main class="inter">
        {{{body}}}
    </main>
</body>
</html>
