<div class="container-md-fluid py-3">

    <!-- Header -->
    <div class="rounded-xl p-4 mb-4 border border-white/10" style="background:#0d0d0d;">
        <h1 class="text-2xl font-bold mb-1">
            <i class="fa-solid fa-clock" style="color:#3004f3;"></i> Horarios
        </h1>
        <p class="text-gray-500 text-sm mb-1">Todos los horarios que ofrece HighQuality</p>
        <div class="flex items-center gap-4">
            <span class="text-xs text-gray-600">
                <i class="fa-solid fa-clock"></i> Actualizado:
                <span id="lastUpdated" class="text-primary">ahora</span>
            </span>
            <span class="text-xs text-gray-600">
                <i class="fa-solid fa-list"></i> Total:
                <span id="totalitems" class="text-primary font-bold">—</span>
            </span>
        </div>
    </div>

    <!-- Horarios list -->
    <div class="flex flex-col gap-3" id="horarios"></div>
</div>

<!-- Edit Horario Modal -->
<div class="modal" id="editHorario" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-scrollable" style="max-width:480px;">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title"><i class="fa-solid fa-clock"></i> Editar Horario</h2>
                    <span class="text-xs text-gray-500 mt-1 block" id="idUpdate"></span>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="horas-edit" class="flex flex-col gap-2 mb-4"></div>
                <div class="flex justify-center">
                    <button class="btn btn-dark gap-2" type="button" onclick="agregarHora(this)">
                        <i class="fa-solid fa-clock"></i> Agregar Hora
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-dark" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-light" onclick="actualizarHorario()">
                    <i class="fa-solid fa-floppy-disk"></i> Actualizar
                </button>
            </div>
        </div>
    </div>
</div>

<script src="/js/admin/horarios.js"></script>
