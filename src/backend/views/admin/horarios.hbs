<div class="max-w-screen-xl mx-auto px-4 sm:px-6 py-4">
    <!-- Header -->
    <div class="bg-[#0d0d0d] border border-white/8 rounded-xl p-4 mb-4">
        <h1 class="text-xl font-bold mb-1 flex items-center gap-2">
            <i class="fa-solid fa-clock text-primary"></i> Horarios
        </h1>
        <p class="text-gray-500 text-sm mb-0">Configura el horario de atención por día. Define el rango de horas de inicio y cierre. Las citas se generan cada 30 minutos.</p>
    </div>

    <!-- Horarios list -->
    <div class="flex flex-col gap-3" id="horarios"></div>
</div>

<!-- Edit Horario Modal -->
<div class="modal" id="editHorario" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-scrollable" style="max-width:480px;">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title"><i class="fa-solid fa-clock"></i> Editar Horario</h2>
                    <span class="text-sm text-gray-500" id="editDayName"></span>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-gray-400 text-sm mb-4">
                    Las citas se generarán cada <strong class="text-white">30 minutos</strong> desde la hora de inicio hasta 30 min antes de la hora de cierre.
                </p>
                <div class="flex flex-col gap-4">
                    <div>
                        <label class="form-label">Hora de inicio</label>
                        <input type="time" class="form-control" id="editStartTime" step="1800">
                        <small class="text-gray-500">Primera cita disponible</small>
                    </div>
                    <div>
                        <label class="form-label">Hora de cierre</label>
                        <input type="time" class="form-control" id="editEndTime" step="1800">
                        <small class="text-gray-500">Hora de cierre (última cita = cierre - 30 min)</small>
                    </div>
                </div>
                <!-- Preview slots -->
                <div class="mt-4">
                    <p class="text-xs text-gray-500 mb-2">Vista previa de citas disponibles:</p>
                    <div id="slotsPreview" class="flex flex-wrap gap-1"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-dark" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-light" onclick="actualizarHorario()">
                    <i class="fa-solid fa-floppy-disk"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<script src="/js/admin/horarios.js"></script>
