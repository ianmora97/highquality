<!-- DataTables -->
<script src="/scripts/datatables.net/js/dataTables.min.js"></script>
<script src="/scripts/datatables.net-responsive/js/dataTables.responsive.min.js"></script>

<div class="container-md-fluid py-3">

    <!-- Header -->
    <div class="rounded-xl p-4 mb-4 border border-white/10 flex items-center justify-between animate__animated animate__fadeInUp" style="background:#0d0d0d;">
        <div>
            <h1 class="text-2xl font-bold mb-1">
                <i class="fa-solid fa-users" style="color:#3004f3;"></i> Clientes
            </h1>
            <p class="text-gray-500 text-sm mb-1">Todos los clientes registrados</p>
            <span class="text-xs text-gray-600">
                <i class="fa-solid fa-clock"></i> Actualizado: <span id="lastUpdated" class="text-primary">ahora</span>
            </span>
        </div>
        <div class="text-right">
            <span class="bebas text-5xl font-bold" style="color:#F4C82C;" id="totalitems">—</span>
            <p class="text-xs text-gray-500 mt-0">clientes</p>
        </div>
    </div>

    <!-- Search bar -->
    <div class="mb-3">
        <div class="relative">
            <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-500"></i>
            <input type="text" id="barraBuscar" placeholder="Buscar cliente..."
                   class="form-control pl-9 py-2.5">
        </div>
    </div>

    <!-- Table -->
    <div class="rounded-xl border border-white/10 overflow-hidden animate__animated animate__fadeInUp" id="table-container" style="background:#0d0d0d;">
        <table id="table" class="table table-custom table-striped nowrap align-middle w-100 position-relative">
            <thead>
                <tr id="thead">
                    <th data-priority="1"><i class="fa-solid fa-id-card"></i> Nombre</th>
                    <th data-priority="2"><i class="fa-solid fa-calendar-days"></i> Citas</th>
                    <th data-priority="3"><i class="fa-solid fa-phone"></i> Teléfono</th>
                </tr>
            </thead>
            <tbody id="tbody">
                <tr class="placeholder-glow">
                    <td><span class="placeholder col-10"></span></td>
                    <td><span class="placeholder col-10"></span></td>
                    <td><span class="placeholder col-10"></span></td>
                </tr>
                <tr class="placeholder-glow">
                    <td><span class="placeholder col-10"></span></td>
                    <td><span class="placeholder col-10"></span></td>
                    <td><span class="placeholder col-10"></span></td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Pagination info -->
    <div class="flex items-center justify-between py-3 px-2 mt-2 rounded-xl border border-white/10 animate__animated animate__fadeInUp" style="background:#0d0d0d;">
        <small class="text-gray-500 text-xs" id="info">
            <div class="placeholder-glow">
                <span class="placeholder" style="width:200px;"></span>
            </div>
        </small>
        <div class="pagination-tables" id="pagination"></div>
    </div>
</div>

<script src="/js/admin/clientes.js"></script>
