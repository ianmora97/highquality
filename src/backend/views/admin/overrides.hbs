<script src="/js/admin/overrides.js"></script>

<div x-data="bloqueosPage()">

    <div class="max-w-screen-xl mx-auto px-4 sm:px-6 py-4">

        <!-- KPIs -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 mb-4">
            <div class="rounded-lg p-2.5 bg-gradient-to-br from-rose-500/20 via-red-500/10 to-transparent border border-rose-400/25 flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-rose-400 to-red-600 flex items-center justify-center shrink-0 shadow-lg shadow-rose-500/20">
                    <i class="fa-solid fa-calendar-xmark text-white text-xs"></i>
                </div>
                <div class="min-w-0">
                    <p class="text-[10px] text-rose-300/70 leading-none mb-1 truncate">Vigentes ahora</p>
                    <h2 class="text-base font-bold text-rose-200 leading-none" x-text="vigentes().length"></h2>
                </div>
            </div>
            <div class="rounded-lg p-2.5 bg-gradient-to-br from-orange-500/20 via-amber-500/10 to-transparent border border-orange-400/25 flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-orange-400 to-amber-600 flex items-center justify-center shrink-0 shadow-lg shadow-orange-500/20">
                    <i class="fa-solid fa-hourglass-half text-white text-xs"></i>
                </div>
                <div class="min-w-0">
                    <p class="text-[10px] text-orange-300/70 leading-none mb-1 truncate">Próximos</p>
                    <h2 class="text-base font-bold text-orange-200 leading-none" x-text="proximos().length"></h2>
                </div>
            </div>
            <div class="rounded-lg p-2.5 bg-gradient-to-br from-violet-500/20 via-purple-500/10 to-transparent border border-violet-400/25 flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-violet-400 to-purple-600 flex items-center justify-center shrink-0 shadow-lg shadow-violet-500/20">
                    <i class="fa-solid fa-calendar-day text-white text-xs"></i>
                </div>
                <div class="min-w-0">
                    <p class="text-[10px] text-violet-300/70 leading-none mb-1 truncate">Días cerrados</p>
                    <h2 class="text-base font-bold text-violet-200 leading-none" x-text="diasCerrados()"></h2>
                </div>
            </div>
            <div class="rounded-lg p-2.5 bg-gradient-to-br from-blue-500/20 via-primary/10 to-transparent border border-blue-400/25 flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-400 to-primary flex items-center justify-center shrink-0 shadow-lg shadow-blue-500/20">
                    <i class="fa-solid fa-triangle-exclamation text-white text-xs"></i>
                </div>
                <div class="min-w-0">
                    <p class="text-[10px] text-blue-300/70 leading-none mb-1 truncate">Citas por mover</p>
                    <h2 class="text-base font-bold text-blue-200 leading-none" x-text="citasEnRiesgo()"></h2>
                </div>
            </div>
        </div>

        <div class="grid lg:grid-cols-12 gap-3">

            <!-- ── CALENDARIO ── -->
            <div class="lg:col-span-5">
                <div class="rounded-xl bg-[#0d0d0d] border border-white/10 p-3.5 lg:sticky lg:top-4">

                    <div class="flex items-center justify-between mb-3">
                        <button @click="mesAnterior()"
                                class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-400 bg-white/5 hover:text-white hover:bg-white/10 transition-all">
                            <i class="fa-solid fa-chevron-left text-xs"></i>
                        </button>
                        <div class="text-center">
                            <p class="text-sm font-bold text-white capitalize leading-none" x-text="mesLabel()"></p>
                            <button @click="irHoy()" class="text-[10px] text-primary hover:underline mt-1">Hoy</button>
                        </div>
                        <button @click="mesSiguiente()"
                                class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-400 bg-white/5 hover:text-white hover:bg-white/10 transition-all">
                            <i class="fa-solid fa-chevron-right text-xs"></i>
                        </button>
                    </div>

                    <div class="grid grid-cols-7 gap-1 mb-1">
                        <template x-for="(d, i) in ['L','M','M','J','V','S','D']" :key="i">
                            <span class="text-center text-[10px] font-semibold text-gray-600" x-text="d"></span>
                        </template>
                    </div>

                    <div class="grid grid-cols-7 gap-1">
                        <template x-for="c in diasMes()" :key="c.iso">
                            <button @click="desdeCalendario(c)"
                                    :title="c.blocked ? c.title : (c.closed ? 'Día cerrado en el horario' : '')"
                                    class="relative aspect-square rounded-lg border text-xs font-semibold flex flex-col items-center justify-center transition-all"
                                    :class="claseDia(c)">
                                <span x-text="c.num"></span>
                                <span x-show="c.citas" class="absolute bottom-1 flex gap-0.5">
                                    <span class="w-1 h-1 rounded-full bg-gold"></span>
                                    <span x-show="c.citas > 2" class="w-1 h-1 rounded-full bg-gold"></span>
                                    <span x-show="c.citas > 5" class="w-1 h-1 rounded-full bg-gold"></span>
                                </span>
                            </button>
                        </template>
                    </div>

                    <!-- Leyenda -->
                    <div class="flex flex-wrap gap-x-3 gap-y-1.5 mt-3 pt-3 border-t border-white/8">
                        <span class="inline-flex items-center gap-1.5 text-[10px] text-gray-500">
                            <span class="w-2.5 h-2.5 rounded bg-rose-500/25 border border-rose-400/50"></span> Bloqueado
                        </span>
                        <span class="inline-flex items-center gap-1.5 text-[10px] text-gray-500">
                            <span class="w-2.5 h-2.5 rounded bg-white/5 border border-white/10"></span> Cerrado por horario
                        </span>
                        <span class="inline-flex items-center gap-1.5 text-[10px] text-gray-500">
                            <span class="w-1 h-1 rounded-full bg-gold"></span> Citas agendadas
                        </span>
                    </div>

                    <p class="text-[11px] text-gray-600 mt-3">
                        <i class="fa-solid fa-hand-pointer me-1"></i>
                        Toca un día para bloquearlo. Si ya está bloqueado, se abre para editarlo.
                    </p>

                    <div class="rounded-xl bg-white/[.03] border border-white/8 p-3 mt-3">
                        <p class="text-[11px] text-gray-400 leading-relaxed mb-0">
                            <i class="fa-solid fa-circle-info text-primary me-1"></i>
                            Los bloqueos cierran <strong class="text-white">días completos</strong>.
                            Para cerrar solo unas horas usa <a href="/dashboard/panel" class="text-primary hover:underline">Cerrar horario</a> en el panel.
                        </p>
                    </div>
                </div>
            </div>

            <!-- ── LISTA ── -->
            <div class="lg:col-span-7">

                <!-- Toolbar -->
                <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-3">
                    <div class="flex-1 flex items-center gap-2.5 bg-white/5 border border-white/10 rounded-xl px-3.5 focus-within:border-primary/50 transition-all">
                        <i class="fa-solid fa-magnifying-glass text-gray-500 text-xs shrink-0"></i>
                        <input type="text" x-model="query" placeholder="Buscar bloqueo..."
                               class="w-full min-w-0 bg-transparent border-0 py-2.5 text-sm text-white outline-none placeholder:text-gray-600">
                        <button x-show="query" @click="query = ''" class="text-gray-500 hover:text-white shrink-0">
                            <i class="fa-solid fa-circle-xmark text-xs"></i>
                        </button>
                    </div>

                    <div class="flex items-center gap-2">
                        <div class="flex items-center gap-1 p-1 rounded-xl bg-white/[.03] border border-white/8">
                            <template x-for="f in [['activos','Activos'],['pasados','Pasados'],['todos','Todos']]" :key="f[0]">
                                <button @click="filtro = f[0]"
                                        class="px-2.5 sm:px-3 py-1.5 rounded-lg text-xs font-semibold transition-all whitespace-nowrap"
                                        :class="filtro === f[0] ? 'bg-primary/20 text-white border border-primary/40' : 'text-gray-500 hover:text-gray-300 border border-transparent'"
                                        x-text="f[1]"></button>
                            </template>
                        </div>

                        <button @click="abrirNuevo()"
                                class="h-10 px-3.5 flex items-center gap-2 rounded-xl bg-primary text-white text-sm font-bold hover:opacity-90 active:scale-95 transition-all shrink-0 whitespace-nowrap">
                            <i class="fa-solid fa-plus text-xs"></i>
                            <span>Nuevo</span>
                        </button>
                    </div>
                </div>

                <!-- Skeleton -->
                <div x-show="loading" class="flex flex-col gap-2.5">
                    <template x-for="i in 4" :key="i">
                        <div class="h-[86px] rounded-xl bg-white/[.03] border border-white/8 animate-pulse"></div>
                    </template>
                </div>

                <!-- Cards -->
                <div x-show="!loading" class="flex flex-col gap-2.5">
                    <template x-for="b in filtrados()" :key="b._id">
                        <div @click="abrirEditar(b)"
                             class="group rounded-xl bg-[#0d0d0d] border p-3.5 cursor-pointer transition-all flex items-start gap-3"
                             :class="b._estado === 'pasado' ? 'border-white/8 opacity-60 hover:opacity-90' : 'border-rose-400/20 hover:border-rose-400/40'">

                            <div class="w-10 h-10 rounded-xl border flex items-center justify-center shrink-0"
                                 :class="b._estado === 'pasado'
                                    ? 'bg-white/[.03] border-white/8 text-gray-600'
                                    : 'bg-gradient-to-br from-rose-500/20 to-red-600/10 border-rose-400/30 text-rose-300'">
                                <i :class="b._icon"></i>
                            </div>

                            <div class="flex-1 min-w-0">
                                <div class="flex items-start justify-between gap-2">
                                    <h5 class="text-sm font-bold text-white leading-snug truncate" x-text="b.title"></h5>
                                    <span class="text-[10px] font-semibold uppercase tracking-widest px-2 py-0.5 rounded-lg shrink-0"
                                          :class="{
                                            'bg-rose-500/10 border border-rose-400/30 text-rose-300': b._estado === 'vigente',
                                            'bg-amber-500/10 border border-amber-400/30 text-amber-300': b._estado === 'proximo',
                                            'bg-white/5 border border-white/10 text-gray-500': b._estado === 'pasado'
                                          }"
                                          x-text="b._estado === 'vigente' ? 'En curso' : b._estado === 'proximo' ? 'Próximo' : 'Pasado'"></span>
                                </div>

                                <p class="text-xs text-gray-500 first-letter:uppercase mt-0.5" x-text="b._rango"></p>

                                <div class="flex flex-wrap items-center gap-1.5 mt-2">
                                    <span class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-lg bg-white/[.04] border border-white/8 text-gray-400">
                                        <i class="fa-solid fa-calendar-day text-[9px]"></i>
                                        <span x-text="b._dias + (b._dias === 1 ? ' día' : ' días')"></span>
                                    </span>
                                    <span x-show="b._estado === 'proximo'"
                                          class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-lg bg-white/[.04] border border-white/8 text-gray-400">
                                        <i class="fa-solid fa-clock text-[9px]"></i>
                                        <span x-text="b._enCuanto"></span>
                                    </span>
                                    <span x-show="citasDe(b).length"
                                          class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-lg bg-amber-500/10 border border-amber-400/30 text-amber-300">
                                        <i class="fa-solid fa-triangle-exclamation text-[9px]"></i>
                                        <span x-text="citasDe(b).length + (citasDe(b).length === 1 ? ' cita dentro' : ' citas dentro')"></span>
                                    </span>
                                </div>
                            </div>

                            <button @click.stop="eliminar(b)"
                                    class="w-9 h-9 flex items-center justify-center rounded-xl text-gray-500 bg-white/5 hover:text-red-400 hover:bg-red-500/10 transition-all shrink-0">
                                <i class="fa-solid fa-trash text-xs"></i>
                            </button>
                        </div>
                    </template>
                </div>

                <!-- Empty states -->
                <!-- Sin bloqueos activos, pero sí historial -->
                <div x-show="!loading && !filtrados().length && bloqueos.length && filtro === 'activos' && !query.trim()"
                     class="text-center py-14">
                    <i class="fa-solid fa-calendar-check text-gray-700 text-3xl mb-3"></i>
                    <p class="text-sm text-gray-500 mb-1">No hay bloqueos activos.</p>
                    <p class="text-xs text-gray-600 mb-4">
                        La agenda está abierta. Hay <span x-text="bloqueos.length"></span> bloqueo<span x-show="bloqueos.length !== 1">s</span> en el historial.
                    </p>
                    <div class="flex items-center justify-center gap-2">
                        <button @click="abrirNuevo()"
                                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-primary text-white text-sm font-bold hover:opacity-90 transition-all">
                            <i class="fa-solid fa-plus text-xs"></i> Crear bloqueo
                        </button>
                        <button @click="filtro = 'pasados'"
                                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-gray-300 text-sm font-semibold hover:bg-white/10 transition-all">
                            <i class="fa-solid fa-clock-rotate-left text-xs"></i> Ver historial
                        </button>
                    </div>
                </div>

                <!-- Filtro/búsqueda sin resultados -->
                <div x-show="!loading && !filtrados().length && bloqueos.length && (filtro !== 'activos' || query.trim())"
                     class="text-center py-14">
                    <i class="fa-solid fa-magnifying-glass text-gray-700 text-2xl mb-3"></i>
                    <p class="text-sm text-gray-500 mb-4">Ningún bloqueo coincide con el filtro.</p>
                    <button @click="query = ''; filtro = 'todos'"
                            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-gray-300 text-sm font-semibold hover:bg-white/10 transition-all">
                        <i class="fa-solid fa-rotate-left text-xs"></i> Limpiar filtros
                    </button>
                </div>

                <div x-show="!loading && !bloqueos.length" class="text-center py-14">
                    <i class="fa-solid fa-calendar-check text-gray-700 text-3xl mb-3"></i>
                    <p class="text-sm text-gray-500 mb-1">No hay bloqueos.</p>
                    <p class="text-xs text-gray-600 mb-4">La agenda está abierta según el horario de cada día.</p>
                    <button @click="abrirNuevo()"
                            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-primary text-white text-sm font-bold hover:opacity-90 transition-all">
                        <i class="fa-solid fa-plus text-xs"></i> Crear bloqueo
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== BLOQUEO SHEET (crear / editar) ===== -->
    <div x-show="open"
         x-effect="document.documentElement.style.overflow = open ? 'hidden' : ''"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         @keydown.escape.window="cerrar()"
         @click="cerrar()"
         class="fixed inset-0 z-50 flex items-end sm:items-center justify-center sm:p-4"
         style="background:rgba(0,0,0,0.75); backdrop-filter:blur(6px);"
         x-cloak>

        <div x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0 translate-y-full"
             x-transition:enter-end="opacity-100 translate-y-0"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100 translate-y-0"
             x-transition:leave-end="opacity-0 translate-y-full"
             class="w-full sm:max-w-md bg-[#0d0d0d] border border-white/10 rounded-t-3xl sm:rounded-2xl overflow-hidden shadow-2xl flex flex-col max-h-[92dvh] sm:max-h-[86vh]"
             :style="dragY ? `transform: translateY(${dragY}px)` : ''"
             @click.stop>

            <!-- Drag handle (mobile) -->
            <div class="flex justify-center pt-3 pb-2 sm:hidden cursor-grab shrink-0"
                 @touchstart="onDragStart($event)"
                 @touchmove="onDragMove($event)"
                 @touchend="onDragEnd($event)">
                <div class="w-10 h-1.5 rounded-full bg-white/20"></div>
            </div>

            <!-- HEADER -->
            <div class="px-3.5 pt-2 pb-3.5 shrink-0 border-b border-white/8">
                <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-xl bg-rose-500/10 border border-rose-400/25 flex items-center justify-center shrink-0">
                        <i :class="form.icon" class="text-rose-300"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h2 class="text-lg font-bold text-white leading-tight"
                            x-text="mode === 'add' ? 'Nuevo bloqueo' : 'Editar bloqueo'"></h2>
                        <p class="text-xs text-gray-500 mt-0.5 first-letter:uppercase" x-text="resumen() || 'Elige las fechas a cerrar'"></p>
                    </div>
                    <button @click="cerrar()"
                            class="w-9 h-9 flex items-center justify-center rounded-xl text-gray-400 bg-white/5 hover:text-white hover:bg-white/10 transition-all shrink-0">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>
            </div>

            <!-- BODY -->
            <div class="flex-1 overflow-y-auto px-3.5 py-3.5 min-h-0">

                <!-- Paso 1 — motivo -->
                <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-1.5">1 · Motivo</label>
                <div class="flex flex-wrap gap-1.5 mb-2">
                    <template x-for="m in MOTIVOS" :key="m.t">
                        <button @click="usarMotivo(m)"
                                class="inline-flex items-center gap-1.5 text-[11px] px-2.5 py-1.5 rounded-lg border transition-all"
                                :class="form.title === m.t ? 'bg-rose-500/15 border-rose-400/40 text-rose-200' : 'bg-white/[.03] border-white/8 text-gray-400 hover:text-gray-200'">
                            <i :class="m.i" class="text-[10px]"></i>
                            <span x-text="m.t"></span>
                        </button>
                    </template>
                </div>
                <div class="flex items-center gap-2.5 bg-white/5 border border-white/10 rounded-xl px-3.5 mb-4 focus-within:border-primary/50 transition-all">
                    <i class="fa-solid fa-pen text-gray-500 text-xs shrink-0"></i>
                    <input type="text" x-model="form.title" maxlength="60" placeholder="Escribe el motivo..."
                           class="w-full min-w-0 bg-transparent border-0 py-2.5 text-sm text-white outline-none placeholder:text-gray-600">
                </div>

                <!-- Paso 2 — fechas -->
                <div class="flex items-center justify-between mb-1.5">
                    <label class="text-[10px] text-gray-500 uppercase tracking-widest">2 · Fechas</label>
                    <button x-show="form.start" @click="limpiarFechas()" class="text-[10px] text-gray-500 hover:text-white">
                        <i class="fa-solid fa-rotate-left me-1"></i> Reiniciar
                    </button>
                </div>

                <div class="flex flex-wrap gap-1.5 mb-2">
                    <template x-for="p in PRESETS" :key="p.t">
                        <button @click="usarPreset(p)"
                                class="text-[11px] px-2.5 py-1.5 rounded-lg border transition-all bg-white/[.03] border-white/8 text-gray-400 hover:text-gray-200 hover:border-primary/40"
                                x-text="p.t"></button>
                    </template>
                </div>

                <!-- Mini calendario de selección -->
                <div class="rounded-xl bg-white/[.03] border border-white/8 p-3 mb-2">
                    <div class="flex items-center justify-between mb-2.5">
                        <button @click="pickMesAnterior()"
                                class="w-7 h-7 flex items-center justify-center rounded-lg text-gray-400 bg-white/5 hover:text-white hover:bg-white/10 transition-all">
                            <i class="fa-solid fa-chevron-left text-[10px]"></i>
                        </button>
                        <p class="text-xs font-bold text-white capitalize" x-text="pickMesLabel()"></p>
                        <button @click="pickMesSiguiente()"
                                class="w-7 h-7 flex items-center justify-center rounded-lg text-gray-400 bg-white/5 hover:text-white hover:bg-white/10 transition-all">
                            <i class="fa-solid fa-chevron-right text-[10px]"></i>
                        </button>
                    </div>

                    <div class="grid grid-cols-7 gap-1 mb-1">
                        <template x-for="(d, i) in ['L','M','M','J','V','S','D']" :key="i">
                            <span class="text-center text-[9px] font-semibold text-gray-600" x-text="d"></span>
                        </template>
                    </div>

                    <div class="grid grid-cols-7 gap-1">
                        <template x-for="c in pickDias()" :key="c.iso">
                            <button @click="seleccionar(c)"
                                    class="aspect-square rounded-lg border text-[11px] font-semibold flex items-center justify-center transition-all"
                                    :class="clasePick(c)"
                                    x-text="c.num"></button>
                        </template>
                    </div>

                    <p class="text-[11px] text-center mt-2.5"
                       :class="form.start && !form.end ? 'text-primary' : 'text-gray-600'"
                       x-text="pistaFechas()"></p>
                </div>

                <!-- Resumen del rango -->
                <div x-show="form.start"
                     class="flex items-center gap-3 rounded-xl bg-rose-500/[.06] border border-rose-400/25 p-3 mb-4">
                    <i class="fa-solid fa-calendar-xmark text-rose-300 shrink-0"></i>
                    <div class="min-w-0 flex-1">
                        <p class="text-xs font-bold text-rose-200 first-letter:uppercase" x-text="resumen()"></p>
                        <p class="text-[11px] text-gray-500" x-text="detalleDias()"></p>
                    </div>
                </div>

                <!-- Paso 3 — citas dentro del rango -->
                <div x-show="form.start">
                    <label class="block text-[10px] text-gray-500 uppercase tracking-widest mb-1.5">3 · Citas dentro del rango</label>

                    <div x-show="conflictLoading" class="rounded-xl bg-white/[.03] border border-white/8 p-3 text-xs text-gray-500">
                        <i class="fa-solid fa-circle-notch fa-spin me-1.5"></i> Revisando la agenda...
                    </div>

                    <div x-show="!conflictLoading && !conflictos.length"
                         class="flex items-center gap-2.5 rounded-xl bg-emerald-500/[.06] border border-emerald-400/25 p-3 mb-4">
                        <i class="fa-solid fa-circle-check text-emerald-300 shrink-0"></i>
                        <p class="text-xs text-emerald-200 mb-0">No hay citas agendadas en esas fechas.</p>
                    </div>

                    <div x-show="!conflictLoading && conflictos.length" class="mb-4">
                        <div class="flex items-start gap-2.5 rounded-xl bg-amber-500/[.06] border border-amber-400/25 p-3 mb-2">
                            <i class="fa-solid fa-triangle-exclamation text-amber-300 mt-0.5 shrink-0"></i>
                            <p class="text-xs text-amber-200 mb-0 leading-relaxed">
                                <strong x-text="conflictos.length"></strong>
                                <span x-text="conflictos.length === 1 ? ' cita queda dentro del bloqueo.' : ' citas quedan dentro del bloqueo.'"></span>
                                Avisa a cada cliente o elimina la cita antes de cerrar.
                            </p>
                        </div>

                        <div class="space-y-1.5 max-h-52 overflow-y-auto">
                            <template x-for="c in conflictos" :key="c._id">
                                <div class="flex items-center gap-2.5 rounded-xl bg-white/[.03] border border-white/8 p-2.5">
                                    <div class="min-w-0 flex-1">
                                        <p class="text-xs font-bold text-white truncate" x-text="c.title"></p>
                                        <p class="text-[11px] text-gray-500 first-letter:uppercase" x-text="cuando(c)"></p>
                                    </div>
                                    <a :href="waLink(c)" target="_blank" rel="noopener" @click.stop
                                       class="w-8 h-8 flex items-center justify-center rounded-lg text-emerald-300 bg-emerald-500/10 border border-emerald-400/25 hover:bg-emerald-500/20 transition-all shrink-0"
                                       title="Avisar por WhatsApp">
                                        <i class="fa-brands fa-whatsapp text-xs"></i>
                                    </a>
                                    <button @click="eliminarCita(c)"
                                            class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-500 bg-white/5 hover:text-red-400 hover:bg-red-500/10 transition-all shrink-0"
                                            title="Eliminar cita">
                                        <i class="fa-solid fa-trash text-[10px]"></i>
                                    </button>
                                </div>
                            </template>
                        </div>
                    </div>
                </div>

                <p x-show="errorMsg" x-text="errorMsg" class="text-xs text-danger mt-1"></p>

                <!-- Danger zone -->
                <div x-show="mode === 'edit'" class="mt-5 pt-4 border-t border-white/8">
                    <button @click="eliminarActual()" :disabled="saving"
                            class="w-full py-2.5 rounded-xl border border-red-500/25 bg-red-500/[.06] text-xs font-semibold text-red-400 hover:bg-red-500/15 transition-all disabled:opacity-40">
                        <i class="fa-solid fa-trash me-1.5"></i> Quitar bloqueo
                    </button>
                </div>
            </div>

            <!-- FOOTER -->
            <div class="shrink-0 px-3.5 py-3.5 border-t border-white/8 bg-[#0d0d0d] flex gap-2"
                 style="padding-bottom: calc(1rem + env(safe-area-inset-bottom));">
                <button @click="cerrar()"
                        class="px-4 bg-white/5 border border-white/8 text-gray-400 rounded-xl text-sm hover:bg-white/10 transition-all">
                    Cancelar
                </button>
                <button @click="guardar()" :disabled="saving || !form.start || !form.title.trim()"
                        class="flex-1 bg-danger text-white rounded-xl py-3 text-sm font-bold hover:opacity-90 active:scale-95 transition-all disabled:opacity-40 disabled:active:scale-100">
                    <i class="fa-solid fa-ban me-1.5"></i>
                    <span x-text="saving ? 'Guardando...' : (mode === 'add' ? 'Crear bloqueo' : 'Guardar cambios')"></span>
                </button>
            </div>
        </div>
    </div>
</div>
