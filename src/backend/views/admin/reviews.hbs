<div class="max-w-screen-xl mx-auto px-4 sm:px-6 py-4">

    <!-- Header -->
    <div class="bg-[#0d0d0d] border border-white/8 rounded-xl p-4 mb-4">
        <div class="flex items-center justify-between flex-wrap gap-3">
            <div>
                <h1 class="text-xl font-bold mb-1 flex items-center gap-2">
                    <i class="fa-solid fa-star text-gold"></i> Reviews
                </h1>
                <p class="text-gray-500 text-sm mb-0">Opiniones de los clientes</p>
            </div>
            <div class="flex items-center gap-6">
                <div class="text-center">
                    <div class="text-xl font-bold text-white" id="totalitems">—</div>
                    <div class="text-xs text-gray-500">Total</div>
                </div>
                <div class="text-center">
                    <div class="text-xl font-bold text-yellow-400" id="displayCount">—</div>
                    <div class="text-xs text-gray-500">Visibles</div>
                </div>
                <div class="text-center">
                    <div class="text-xl font-bold text-primary" id="avgStars">—</div>
                    <div class="text-xs text-gray-500">Promedio ★</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter tabs -->
    <div class="flex gap-2 mb-4">
        <button class="btn btn-sm btn-primary" onclick="filterReviews('all')" id="filter-all">Todos</button>
        <button class="btn btn-sm btn-dark" onclick="filterReviews('visible')" id="filter-visible">
            <i class="fa-solid fa-eye"></i> Visibles
        </button>
        <button class="btn btn-sm btn-dark" onclick="filterReviews('hidden')" id="filter-hidden">
            <i class="fa-solid fa-eye-slash"></i> Ocultos
        </button>
    </div>

    <!-- Reviews grid -->
    <div class="grid gap-3" id="list" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));"></div>
</div>

<script src="/js/admin/reviews.js"></script>
