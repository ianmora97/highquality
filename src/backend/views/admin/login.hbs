<div class="min-h-screen flex items-center justify-center p-4" style="background:linear-gradient(135deg,#0a0a0a 0%,#141428 100%);">
    <div class="w-full max-w-sm">

        <!-- Logo -->
        <div class="text-center mb-8">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center">
                <img src="/images/simple-logo.png" alt="HighQuality" width="36" height="36">
            </div>
            <h1 class="nautigal text-white mb-2" style="font-size:3rem; font-weight:700; line-height:1;">HighQuality</h1>
            <p class="text-gray-500 text-xs tracking-widest uppercase">Admin Panel</p>
        </div>

        <!-- Card -->
        <div class="bg-[#0d0d0d] border border-white/8 rounded-2xl p-8 animate__animated animate__fadeInUp animate__faster">
            <form action="/dashboard/login" method="post" id="loginForm">
                <div class="space-y-4 mb-6">
                    <!-- Username -->
                    <div class="relative" id="grpUsername">
                        <i class="fas fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500 text-sm" id="iconUsername"></i>
                        <input type="text" name="user" id="username"
                               class="w-full bg-white/5 border border-white/10 rounded-xl pl-10 pr-4 py-3 text-white text-sm placeholder-gray-600 outline-none transition-all"
                               style="font-family:'Inter',sans-serif;"
                               placeholder="Username" autocomplete="username" required>
                    </div>
                    <!-- Password -->
                    <div class="relative" id="grpPassword">
                        <i class="fas fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500 text-sm" id="iconPassword"></i>
                        <input type="password" name="password" id="password"
                               class="w-full bg-white/5 border border-white/10 rounded-xl pl-10 pr-4 py-3 text-white text-sm placeholder-gray-600 outline-none transition-all"
                               style="font-family:'Inter',sans-serif;"
                               placeholder="Password" autocomplete="current-password" required>
                    </div>
                </div>

                <button type="submit" id="loginBtn"
                        class="w-full bg-primary hover:opacity-90 text-white font-semibold py-3 rounded-xl transition-all text-sm tracking-wide">
                    Sign In
                </button>
            </form>
        </div>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('loginForm');
    var inputs = form.querySelectorAll('input');

    inputs.forEach(function(input) {
        input.addEventListener('focus', function() {
            this.style.borderColor = '#3004f3';
            this.style.background = 'rgba(48,4,243,0.05)';
        });
        input.addEventListener('blur', function() {
            this.style.borderColor = '';
            this.style.background = '';
        });
    });

    form.addEventListener('submit', function(e) {
        var valid = true;
        inputs.forEach(function(input) {
            if (input.value.trim() === '') {
                e.preventDefault();
                input.style.borderColor = '#e74c3c';
                setTimeout(function() { input.style.borderColor = ''; }, 600);
                valid = false;
            }
        });
        if (valid) {
            var btn = document.getElementById('loginBtn');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Signing In...';
            btn.style.pointerEvents = 'none';
            btn.style.opacity = '0.7';
        }
    });
});
</script>
