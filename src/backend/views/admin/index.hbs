<!-- FullCalendar -->
<script src="/scripts/@fullcalendar/core/index.global.min.js"></script>
<script src="/scripts/@fullcalendar/daygrid/index.global.min.js"></script>
<script src="/scripts/@fullcalendar/timegrid/index.global.min.js"></script>
<script src="/scripts/@fullcalendar/interaction/index.global.min.js"></script>
<script src="/scripts/@fullcalendar/moment/index.global.min.js"></script>
<script src="/scripts/@fullcalendar/multimonth/index.global.min.js"></script>
<script src="/scripts/chart.js/dist/chart.umd.js"></script>
<script src="/scripts/@selectize/selectize/dist/js/selectize.min.js"></script>
<link rel="stylesheet" href="/scripts/@selectize/selectize/dist/css/selectize.css">

<div class="container-md-fluid py-3">
    <!-- KPI Cards -->
    <div class="flex flex-wrap gap-3 mb-3">
        <!-- Ganancias hoy -->
        <div class="flex-1 min-w-[140px] rounded-xl p-4 border-l-4 border-gray-500 animate__animated animate__fadeInDown"
             style="background:rgba(107,114,128,0.1); border-left-color:#6b7280;">
            <h2 class="text-3xl font-bold text-gray-400" id="countGanancias">0</h2>
            <p class="text-sm text-gray-500 mt-1">
                <i class="fa-solid fa-coins text-gray-500"></i> Ganancias de hoy
            </p>
        </div>

        <!-- Citas hoy -->
        <div class="flex-1 min-w-[100px] rounded-xl p-4 border-l-4 border-white animate__animated animate__fadeInDown"
             style="background:#0d0d0d; animation-delay:200ms;">
            <h2 class="text-3xl font-bold text-white" id="countCitas">0</h2>
            <p class="text-sm text-gray-500 mt-1">
                <i class="fa-solid fa-clock"></i> Citas hoy
            </p>
        </div>

        <!-- Ganancias mes -->
        <div class="flex-1 min-w-[180px] rounded-xl p-4 border-l-4 border-primary animate__animated animate__fadeInDown cursor-pointer"
             style="background:rgba(48,4,243,0.1); animation-delay:400ms;" onclick="toggleChart()" role="button">
            <h2 class="text-3xl font-bold text-primary" id="countGananciasMes">₡0</h2>
            <p class="text-sm text-gray-500 mt-1">
                <i class="fa-solid fa-sack-dollar text-primary"></i> Ganancias del Mes
            </p>
        </div>

        <!-- Próxima cita -->
        <div class="w-full rounded-xl p-4 border-l-4 border-success animate__animated animate__fadeInDown"
             style="background:rgba(20,183,58,0.1); animation-delay:600ms;">
            <p class="font-bold text-sm text-success mb-1" id="currentAppointment"></p>
            <p class="text-gray-500 text-sm mb-0">Siguiente: <span id="nextAppointment">—</span></p>
        </div>
    </div>

    <!-- Monthly chart (hidden by default) -->
    <div class="mb-3" style="display:none;" id="gananciaspormes">
        <div class="rounded-xl p-4 border border-white/10" style="background:#0d0d0d;">
            <h3 class="font-bold mb-3">Ganancias por Mes</h3>
            <div style="height:350px;">
                <canvas id="chartGanancias"></canvas>
            </div>
        </div>
    </div>

    <!-- Calendar -->
    <div class="rounded-xl border border-white/10 px-1 md:px-4 py-3" style="background:#0d0d0d;">
        <p class="text-sm text-gray-500 text-center mb-2" id="date">-</p>
        <div id="calendar" class="capitalize"></div>
    </div>
</div>

<!-- Add Event Modal -->
<div class="modal modal-lg" id="addEvent" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-md-down" style="max-width:700px;">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title mb-1">
                        <i class="fa-solid fa-calendar-plus"></i> Agregar Evento
                    </h2>
                    <p class="text-sm text-gray-500 mb-0">
                        <i class="fa-solid fa-calendar-days" style="color:#F4C82C;"></i>
                        <span id="dateSelected" class="capitalize"></span>
                        &nbsp;
                        <i class="fa-solid fa-clock" style="color:#e44e4e;"></i>
                        <span id="timeSelected" class="uppercase"></span>
                    </p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body px-3">
                <!-- Type selector -->
                <div class="mb-3">
                    <label class="form-label">Tipo de Evento</label>
                    <select class="form-select form-select-lg" id="opcionModal" onchange="typeselection(this)">
                        <option value="0" selected>Seleccione una opción</option>
                        <option value="cita">Cita</option>
                        <option value="cerrado">Cerrado</option>
                    </select>
                </div>
                <hr class="border-white/10">

                <!-- Closed form -->
                <div id="cerradoSelection" class="animate__animated animate__fadeIn" style="display:none;">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="allDayClosed">
                        </div>
                        <label for="allDayClosed" class="form-check-label">Todo el día</label>
                    </div>
                    <label class="form-label">Hora: Inicio — Final</label>
                    <div class="input-group mb-3">
                        <input type="time" class="form-control" id="closedHoursStart" placeholder="Inicio">
                        <input type="time" class="form-control" id="closedHoursEnd" placeholder="Final">
                    </div>
                </div>

                <!-- Appointment form -->
                <div id="citaSelection" class="animate__animated animate__fadeIn" style="display:none;">
                    <!-- Client selector -->
                    <div class="mb-3">
                        <div class="flex justify-between items-center mb-2">
                            <label class="form-label mb-0">
                                <i class="fa-solid fa-user text-gray-400"></i> Cliente:
                            </label>
                            <span class="text-sm">
                                <i class="fa-solid fa-phone" style="color:#F4C82C;"></i>
                                <span id="numeroTelefono" class="font-bold"></span>
                            </span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button class="btn btn-dark btn-sm shrink-0" onclick="addNewClientToList()">
                                <i class="fa-solid fa-plus"></i> Nuevo
                            </button>
                            <select id="clientsSelectize" class="flex-fill" placeholder="Nombre del cliente..."></select>
                        </div>
                    </div>
                    <hr class="border-white/10">

                    <!-- Hours -->
                    <p class="text-sm font-semibold mb-2">
                        <i class="fa-solid fa-clock" style="color:#F4C82C;"></i> Hora de la Cita:
                    </p>
                    <div id="horasDisponibles" class="flex flex-wrap gap-2 mb-3"></div>
                    <hr class="border-white/10">

                    <!-- Services -->
                    <p class="text-sm font-semibold mb-2">
                        <i class="fa-solid fa-scissors" style="color:#3086e7;"></i> Servicios:
                    </p>
                    <div id="serviciosDisponibles" class="d-flex gap-2 py-2 flex-wrap mb-2"></div>

                    <!-- Price -->
                    <div class="flex justify-between items-center mt-2">
                        <span class="text-sm font-semibold">Precio Final:</span>
                        <span class="text-sm">
                            ₡<span class="font-bold text-lg" id="precioFinalModal">0</span>
                            <i class="fa-solid fa-coins" style="color:#F4C82C;"></i>
                        </span>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-dark" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-success" onclick="agendarCita()" style="color:white;display:none;" id="agendarCitaButton">
                    <i class="fa-solid fa-circle-plus"></i> Agendar Cita
                </button>
                <button type="button" class="btn btn-primary" onclick="cerrarDia()" style="display:none;" id="salvarCerrado">
                    <i class="fa-solid fa-circle-plus"></i> Cerrar Día
                </button>
            </div>
        </div>
    </div>
</div>

<script src="/js/admin/index.js"></script>
