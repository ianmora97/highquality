"
></script>
<link
  href="
https://cdn.jsdelivr.net/npm/lightgallery@2.9.0/css/lightgallery-bundle.min.css
"
  rel="stylesheet"
/>


<!-- create a gallery using lightgallery js , use all the images [1.jpg ... 7.jpg] from /images/1.jpg -->
<style>
    body{
        background-color: black;
    }
    .gallery-container{
        max-width: 1200px;
        margin: auto;
        padding: 20px;
    }
    .gallery-item{
        width: 100%;
        height: 300px;
        object-fit: cover;
        cursor: pointer;
        border-radius: 10px;
        transition: transform 0.3s ease;
    }
    .gallery-item:hover{
        transform: scale(1.05);
    }
    .gallery-grid{
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 15px;
    }
    .lg-backdrop{
        background-color: rgba(0, 0, 0, 0.9) !important;
    }
    .lg-toolbar{
        background-color: rgba(0, 0, 0, 0.8) !important;
    }
    .lg-outer .lg-thumb-outer{
        background-color: rgba(0, 0, 0, 0.8) !important;
    }
    .lg-outer .lg-thumb-item.active, .lg-outer .lg-thumb-item:hover{
        border-color: #FFD700 !important;
    }
    .lg-outer .lg-thumb-item{
        border-color: white !important;
    }
    .lg-outer .lg-item .lg-image{
        border-radius: 10px;
    }
    .lg-outer .lg-item .lg-image:hover{
        transform: scale(1.05);
    }
</style>
<div class="gallery-container">
    <div id="lightgallery" class="gallery-grid">
        <div class="gallery-item">
            <img src="/images/cortes/1.jpg" alt="Gallery Image 1" class="gallery-item">
        </div>
        <div class="gallery-item">
            <img src="/images/cortes/2.jpg" alt="Gallery Image 2" class="gallery-item">
        </div>
        <div class="gallery-item">
            <img src="/images/cortes/3.jpg" alt="Gallery Image 3" class="gallery-item">
        </div>
        <div class="gallery-item">
            <img src="/images/cortes/4.jpg" alt="Gallery Image 4" class="gallery-item">
        </div>
        <div class="gallery-item">
            <img src="/images/cortes/5.jpg" alt="Gallery Image 5" class="gallery-item">
        </div>
        <div class="gallery-item">
            <img src="/images/cortes/6.jpg" alt="Gallery Image 6" class="gallery-item">
        </div>
        <div class="gallery-item">
            <img src="/images/cortes/7.jpg" alt="Gallery Image 7" class="gallery-item">
        </div>
    </div>
</div>