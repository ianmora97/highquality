<script src="/scripts/@fullcalendar/core/index.global.min.js"></script>
<script src="/scripts/@fullcalendar/daygrid/index.global.min.js"></script>
<script src="/scripts/@fullcalendar/list/index.global.min.js"></script>
<script src="/scripts/@fullcalendar/timegrid/index.global.min.js"></script>
<script src="/scripts/@fullcalendar/interaction/index.global.min.js"></script>
<script src="/scripts/@fullcalendar/bootstrap5/index.global.min.js"></script>
<script src="/scripts/@fullcalendar/moment/index.global.min.js"></script>

<div class="bg-fore p-3 shadow mt-3">
    <p class="small text-muted text-center d-block mb-1" id="date">-</p>
    <div id="calendar" class="text-capitalize"></div>
</div>

<div class="modal fade" id="addEvent" tabindex="-1" 
aria-labelledby="addEventLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header flex-column text-center align-items-center border-0">
                <h2 class="modal-title fs-5 fw-bold d-block mb-1" id="addEventLabel">
                    <i class="fa-duotone fa-calendar-plus"></i> Agendar Cita 
                </h2>
                <div id="noctural" style="display: none;">
                    <span class="badge bg-dark text-success">
                        <i class="fa-duotone fa-moon-stars"></i> Citas cada 30 min activo
                    </span>
                    <p class="small text-muted mb-0">30 min por turno disponibles a partir de medianoche.</p>
                </div>
                <hr class="d-block w-100">
                <div class="d-block">
                    <small class="d-block small text-white lead">
                        <i class="fa-duotone fa-calendar-days text-gold"></i> <span id="dateSelected" class="text-capitalize"></span> 
                        <i class="fa-duotone fa-clock text-maps"></i> <span id="timeSelected" class="text-uppercase"></span>
                    </small>
                </div>
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" 
                data-bs-dismiss="modal" aria-label="Close"></button>
                <hr class="d-block w-100 mb-0">
            </div>
            <div class="modal-body px-1">
                <div class="row mx-0 g-3">
                    <div class="col-12">
                        <div id="citaSelection" class="animate__animated animate__fadeIn">
                            <i class="fa-duotone fa-clock text-gold"></i> <span class="mb-1 d-inline-block">Hora de la Cita:</span>
                            <div id="horasDisponibles"></div>
                            <hr>
                            <i class="fa-solid fa-scissors text-info"></i> <span class="mb-1 d-inline-block">Servicios:</span>
                            <div id="serviciosDisponibles" class="d-flex gap-2 py-2 flex-wrap"></div>
                            <hr>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold">Precio Final:</span>
                                <p class="mb-0">
                                     ₡<span class="fw-bold" id="precioFinalModal"></span> <i class="fa-duotone fa-coins text-gold"></i>
                                </p>
                            </div>
                            <hr>
                            <div class="mb-2">
                                <label for="nombreCita" class="form-label">Nombre</label>
                                <input type="text" class="form-control form-control-lg" id="nombreCita" placeholder="Nombre" autocomplete="name">
                            </div>
                            <div>
                                <label for="numeroTelefono" class="form-label">Número de Teléfono</label>
                                <input type="number" class="form-control form-control-lg" id="numeroTelefono" placeholder="80808080" autocomplete="tel">
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>
            <div class="modal-footer p-0 d-flex justify-content-between gap-0 position-relative">
                <button type="button" class="btn btn-dark flex-fill" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-success flex-fill" onclick="agendarCita()" style="color: white;">
                    <i class="fa-duotone fa-circle-plus"></i> Agendar Cita
                </button>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
<script src="/js/client/reserva.js"></script>