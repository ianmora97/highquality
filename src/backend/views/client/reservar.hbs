<!-- Animate.css for time chips entrance -->
<link rel="stylesheet" href="/scripts/animate.css/animate.min.css">

{{#if client}}
<meta name="client-session-nombre" content="{{client.nombre}}">
<meta name="client-session-numero" content="{{client.numero}}">
{{/if}}

<!-- ===== HERO ===== -->
<section class="booking-page-hero">
    <div class="booking-page-hero-content w-full max-w-7xl mx-auto px-6 md:px-14 pb-10">
        <p class="nautigal text-gold" style="font-size:1.8rem; line-height:1;">High Quality Studio</p>
        <h1 class="bebas text-white leading-none" style="font-size:clamp(3rem,9vw,6rem);">
            Agenda tu<br><span style="color:#F4C82C;">Cita</span>
        </h1>
        <p class="text-gray-400 mt-2" style="font-size:0.9rem;">Tu cita está casi lista.</p>
    </div>
</section>

<!-- ===== BOOKING APP ===== -->
<div style="background-color:#141414; min-height:60vh;">
    <div class="booking-container">

        <!-- Steps bar -->
        <div class="steps-bar" id="steps-bar">
            <div class="step-item active" data-step="1">
                <div class="step-num">
                    <i class="step-icon fa-solid fa-scissors"></i>
                    <i class="step-check fa-solid fa-check"></i>
                </div>
                <span class="step-label">Servicio</span>
            </div>
            <div class="step-connector"></div>
            <div class="step-item" data-step="2">
                <div class="step-num">
                    <i class="step-icon fa-solid fa-calendar"></i>
                    <i class="step-check fa-solid fa-check"></i>
                </div>
                <span class="step-label">Día</span>
            </div>
            <div class="step-connector"></div>
            <div class="step-item" data-step="3">
                <div class="step-num">
                    <i class="step-icon fa-solid fa-clock"></i>
                    <i class="step-check fa-solid fa-check"></i>
                </div>
                <span class="step-label">Hora</span>
            </div>
            <div class="step-connector"></div>
            <div class="step-item" data-step="4">
                <div class="step-num">
                    <i class="step-icon fa-solid fa-user"></i>
                    <i class="step-check fa-solid fa-check"></i>
                </div>
                <span class="step-label">Datos</span>
            </div>
        </div>

        <!-- ===== STEP 1: SERVICES ===== -->
        <div class="booking-step active" id="step-1">
            <div class="step-heading">
                <h2 class="bebas">¿Qué servicio deseas?</h2>
                <p>Puedes seleccionar más de uno</p>
            </div>

            <div id="services-grid" class="services-select-grid">
                <!-- Rendered by JS -->
                <div class="slots-loading" style="grid-column:span 2;">
                    <i class="fa-solid fa-circle-notch fa-spin text-gold"></i> Cargando servicios...
                </div>
            </div>

        </div>

        <!-- ===== STEP 2: DATE ===== -->
        <div class="booking-step" id="step-2">
            <div class="step-heading">
                <h2 class="bebas">Elige el día</h2>
                <p id="step2-subtitle">Selecciona una fecha disponible</p>
            </div>

            <div class="custom-calendar">
                <div class="cal-header">
                    <button class="cal-nav-btn" id="cal-prev" aria-label="Mes anterior">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <span class="cal-month-title bebas" id="cal-month-label">JUNIO 2025</span>
                    <button class="cal-nav-btn" id="cal-next" aria-label="Mes siguiente">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
                <div class="cal-weekdays">
                    <span>Lun</span><span>Mar</span><span>Mié</span>
                    <span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span>
                </div>
                <div id="calendar-grid" class="cal-days-grid"></div>
            </div>

            <p class="text-center text-gray-600 text-xs mt-3">
                <i class="fa-solid fa-circle me-1" style="color:#F4C82C; font-size:0.5rem;"></i>
                Los días atenuados no tienen disponibilidad
            </p>
        </div>

        <!-- ===== STEP 3: TIME ===== -->
        <div class="booking-step" id="step-3">
            <div class="step-heading">
                <h2 class="bebas">¿A qué hora?</h2>
                <p id="step3-date-label" class="capitalize"></p>
            </div>

            <div id="noctural" class="nocturnal-notice">
                <i class="fa-solid fa-moon text-gold"></i>
                <span>Turnos de 30 min disponibles.</span>
            </div>

            <div class="time-legend" id="time-legend" style="display:none;">
                <span class="legend-dot legend-gold"></span>
                <span class="text-xs text-gray-500 me-3">Hora completa</span>
                <span class="legend-dot legend-lightskin"></span>
                <span class="text-xs text-gray-500">Media hora</span>
            </div>

            <div id="horasDisponibles" class="time-chips-grid"></div>
        </div>

        <!-- ===== STEP 4: DATA ===== -->
        <div class="booking-step" id="step-4">
            <div class="step-heading">
                <h2 class="bebas">Tus Datos</h2>
                <p>Confirma tu información para agendar</p>
            </div>

            <!-- Booking summary -->
            <div class="booking-summary-card" id="booking-summary"></div>

            <!-- Logged-in session pill (shown only when session active) -->
            <div id="session-pill" class="animate__animated animate__fadeIn" style="display:none;"></div>

            <!-- Phone first -->
            <div id="phone-section" class="mb-3">
                <label class="form-label" for="numeroTelefono">Número de Teléfono</label>
                <input type="tel" class="form-control form-control-lg" id="numeroTelefono"
                       placeholder="8080 8080" autocomplete="tel" inputmode="numeric" maxlength="9">
                <div id="lookup-status" class="text-sm mt-2" style="display:none;"></div>
            </div>

            <!-- Name (appears after lookup) -->
            <div id="nombre-section" class="mb-3 animate__animated animate__fadeIn" style="display:none;">
                <label class="form-label" for="nombreCita">Nombre completo</label>
                <input type="text" class="form-control form-control-lg" id="nombreCita"
                       placeholder="Tu nombre" autocomplete="name" maxlength="80">
            </div>

            <!-- Optional account actions (appears after lookup) -->
            <div id="account-actions" style="display:none;">
                <!-- Client exists with account → offer login -->
                <div id="action-login" class="rounded-xl p-3 mb-3 animate__animated animate__fadeIn"
                     style="display:none; background:rgba(244,200,44,0.05); border:1px solid rgba(244,200,44,0.15);">
                    <p class="text-sm text-gray-400 mb-2">
                        <i class="fa-solid fa-circle-user me-1" style="color:#F4C82C;"></i>
                        ¿Quieres ver el historial de tus citas?
                    </p>
                    <button class="btn btn-sm btn-dark rounded-pill"
                            onclick="openClientAuth(); showAuthTab('login');">
                        Iniciar sesión <i class="fa-solid fa-arrow-right ms-1"></i>
                    </button>
                </div>
                <!-- New client → offer register -->
                <div id="action-register" class="rounded-xl p-3 mb-3 animate__animated animate__fadeIn"
                     style="display:none; background:rgba(244,200,44,0.05); border:1px solid rgba(244,200,44,0.15);">
                    <p class="text-sm text-gray-400 mb-2">
                        <i class="fa-solid fa-user-plus me-1" style="color:#F4C82C;"></i>
                        ¿Quieres guardar el historial de tus citas?
                    </p>
                    <button class="btn btn-sm btn-dark rounded-pill"
                            onclick="openClientAuth(); showAuthTab('register');">
                        Crear cuenta (opcional) <i class="fa-solid fa-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>

            <p class="text-gray-600 text-xs mt-2">
                <i class="fa-brands fa-whatsapp text-gold me-1"></i>
                Recibirás confirmación vía WhatsApp
            </p>
        </div>

        <!-- Navigation buttons (sticky bottom) -->
        <div class="booking-nav-bar" id="booking-nav">
            <!-- Mini summary - revealed when services are selected -->
            <div class="booking-nav-summary" id="price-total-bar" style="display:none;">
                <div class="price-bar-services" id="price-bar-services"></div>
                <div class="price-bar-total">
                    <span class="price-bar-label">Total</span>
                    <span class="price-bar-amount">₡<span id="precioFinalModal">0</span></span>
                </div>
            </div>
            <!-- Buttons row -->
            <div class="booking-nav-buttons">
                <button class="btn btn-outline-dark btn-lg rounded-pill" id="btn-back" style="display:none;">
                    <i class="fa-solid fa-arrow-left me-2"></i>Atrás
                </button>
                <button class="btn btn-gold btn-lg rounded-pill ms-auto" id="btn-next">
                    Continuar <i class="fa-solid fa-arrow-right ms-2"></i>
                </button>
            </div>
        </div>

    </div>
</div>

<!-- Client Auth Modal -->
<div class="modal" id="clientAuthModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Mi Cuenta</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Tab: Login / Register -->
                <div class="flex gap-2 mb-4">
                    <button class="btn btn-gold btn-sm flex-1" onclick="showAuthTab('login')" id="tab-login-btn">Iniciar Sesión</button>
                    <button class="btn btn-dark btn-sm flex-1" onclick="showAuthTab('register')" id="tab-register-btn">Crear Cuenta</button>
                </div>
                <!-- Login form -->
                <div id="auth-login">
                    <input type="tel" class="form-control mb-2" id="loginNumero" placeholder="Número de teléfono">
                    <input type="password" class="form-control mb-3" id="loginPassword" placeholder="Contraseña">
                    <button class="btn btn-gold w-full rounded-pill" onclick="clientLogin()">Entrar</button>
                </div>
                <!-- Register form -->
                <div id="auth-register" style="display:none;">
                    <input type="text" class="form-control mb-2" id="regNombre" placeholder="Tu nombre">
                    <input type="tel" class="form-control mb-2" id="regNumero" placeholder="Número de teléfono">
                    <input type="password" class="form-control mb-2" id="regPassword" placeholder="Contraseña">
                    <input type="password" class="form-control mb-3" id="regPasswordConfirm" placeholder="Confirmar contraseña">
                    <button class="btn btn-gold w-full rounded-pill" onclick="clientRegister()">Crear Cuenta</button>
                </div>
                <p id="auth-error" class="text-red-400 text-sm mt-2" style="display:none;"></p>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
<script src="/scripts/imask/dist/imask.min.js"></script>
<script src="/js/client/reserva.js"></script>
