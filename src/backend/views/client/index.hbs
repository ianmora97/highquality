<!-- ===== GALLERY PREVIEW ===== -->
<section class="py-24" style="background-color:#0d0d0d;">
    <div class="max-w-6xl mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12" data-aos="fade-up">
            <div>
                <p class="nautigal text-gold mb-1" style="font-size:2rem;">Nuestro trabajo</p>
                <h2 class="bebas text-white leading-none" style="font-size:clamp(2.5rem,6vw,4.5rem);">Galería</h2>
            </div>
            <a href="/galeria" class="btn btn-outline-light rounded-pill mt-4 md:mt-0">
                Ver galería completa <i class="fa-solid fa-arrow-right ms-2"></i>
            </a>
        </div>
        {{!-- Splide in loop mode with the active slide centred and scaled up.
              Slides come from the gallery (6 newest visible photos) and fall
              back to the bundled shots when the collection is empty. --}}
        <div class="gallery-carousel" data-aos="fade-up">
            <section class="splide" id="galeriaCarousel" aria-label="Nuestro trabajo">
                <div class="splide__track">
                    <ul class="splide__list">
                        {{#if hasFotos}}
                            {{#each fotos}}
                                <li class="splide__slide">
                                    <a href="/galeria" class="gallery-slide" aria-label="Ver galería">
                                        <img src="{{imageUrl}}" alt="{{#if title}}{{title}}{{else}}Trabajo de HighQuality Studio{{/if}}"
                                             loading="lazy" decoding="async">
                                        <span class="gallery-slide-glow"></span>
                                        {{#if title}}
                                            <span class="gallery-slide-caption">
                                                {{title}}
                                                {{#if instagramLink}}<em>@{{instagramLink}}</em>{{/if}}
                                            </span>
                                        {{/if}}
                                    </a>
                                </li>
                            {{/each}}
                        {{else}}
                            {{#each staticFallback}}
                                <li class="splide__slide">
                                    <a href="/galeria" class="gallery-slide" aria-label="Ver galería">
                                        <img src="{{this}}" alt="Trabajo de HighQuality Studio" loading="lazy" decoding="async">
                                        <span class="gallery-slide-glow"></span>
                                    </a>
                                </li>
                            {{/each}}
                        {{/if}}
                    </ul>
                </div>
            </section>
        </div>
    </div>
</section>

<!-- ===== REVIEWS ===== -->
<section class="py-24" style="background-color:#141414;">
    <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-12" data-aos="fade-up">
            <p class="nautigal text-gold mb-1" style="font-size:2rem;">Lo que dicen</p>
            <h2 class="bebas text-white leading-none" style="font-size:clamp(2.5rem,6vw,4.5rem);">Nuestros Clientes</h2>
        </div>
        <section class="splide" id="opinionesCarousel" data-aos="fade-up">
            <div class="splide__track">
                <ul class="splide__list" id="opinionesList"></ul>
            </div>
        </section>
    </div>
</section>

<!-- ===== CTA STRIP ===== -->
<section class="cta-strip">
    <div class="max-w-4xl mx-auto text-center" data-aos="fade-up">
        <h2 class="bebas text-white leading-none" style="font-size:clamp(2.5rem,7vw,5.5rem);">
            ¿Listo para verte<br><span style="color:#F4C82C;">increíble?</span>
        </h2>
        <p class="text-gray-400 mt-3 mb-8" style="font-size:1rem;">Reserva tu cita en línea y asegura tu lugar hoy mismo.</p>
        <a href="/reservar" class="btn btn-gold btn-lg rounded-pill" style="font-size:1.05rem; padding:0.75rem 2.5rem;">
            <i class="fa-solid fa-calendar-check me-2"></i> Reservar Cita
        </a>
    </div>
</section>

<!-- ===== FOOTER ===== -->
<footer class="pt-16 pb-8 border-t border-white/10" style="background-color:#0d0d0d;">
    <div class="max-w-6xl mx-auto px-6">
        <div class="footer-grid">

            <!-- Brand -->
            <div>
                <img src="/images/logo-tr.png" alt="HighQuality Studio" class="mb-5" style="width:150px;">
                <p class="text-gray-500 text-sm leading-relaxed mb-6">
                    Barbería premium en Hatillo 5, San José. Cortes de cabello y servicio de primera clase para hombres, adolescentes y niños.
                </p>
                <div class="socials-row">
                    {{#if site.links.tel}}
                    <a href="{{site.links.tel}}" class="btn-socials btn-socials--tel" aria-label="Llamar" title="Llamar">
                        <i class="fa-solid fa-phone"></i>
                    </a>
                    {{/if}}
                    {{#if site.links.instagram}}
                    <a href="{{site.links.instagram}}" class="btn-socials btn-socials--ig" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram">
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                    {{/if}}
                    {{#if site.links.whatsapp}}
                    <a href="{{site.links.whatsapp}}" class="btn-socials btn-socials--wa" target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp">
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                    {{/if}}
                    {{#if site.links.maps}}
                    <a href="{{site.links.maps}}" class="btn-socials btn-socials--maps" target="_blank" rel="noopener" aria-label="Google Maps" title="Google Maps">
                        <i class="fa-solid fa-location-dot"></i>
                    </a>
                    {{/if}}
                    {{#if site.links.waze}}
                    <a href="{{site.links.waze}}" class="btn-socials btn-socials--waze" target="_blank" rel="noopener" aria-label="Waze" title="Waze">
                        <i class="fa-brands fa-waze"></i>
                    </a>
                    {{/if}}
                </div>
            </div>

            <!-- Navegación -->
            <div>
                <h5 class="bebas text-white mb-4" style="font-size:1.2rem; letter-spacing:1px;">Navegación</h5>
                <div class="flex flex-col gap-2">
                    <a href="/" class="footer-link">Inicio</a>
                    <a href="/reservar" class="footer-link">Reservar Cita</a>
                    <a href="/galeria" class="footer-link">Galería</a>
                </div>
            </div>

            <!-- Contacto -->
            <div>
                <h5 class="bebas text-white mb-4" style="font-size:1.2rem; letter-spacing:1px;">Contacto</h5>
                <div class="flex flex-col gap-3">
                    {{#if site.contact.address}}
                    <div class="flex items-start gap-3">
                        <i class="fa-solid fa-location-dot text-gold mt-1" style="font-size:0.8rem;"></i>
                        {{#if site.links.maps}}
                        <a href="{{site.links.maps}}" target="_blank" rel="noopener" class="text-gray-500 text-sm hover:text-white transition-colors">{{site.contact.address}}</a>
                        {{else}}
                        <span class="text-gray-500 text-sm">{{site.contact.address}}</span>
                        {{/if}}
                    </div>
                    {{/if}}
                    {{#if site.contact.phone}}
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-phone text-gold" style="font-size:0.8rem;"></i>
                        <a href="{{site.links.tel}}" class="text-gray-500 text-sm hover:text-white transition-colors">{{site.contact.phone}}</a>
                    </div>
                    {{/if}}
                    {{#if site.contact.instagram}}
                    <div class="flex items-center gap-3">
                        <i class="fa-brands fa-instagram text-gold" style="font-size:0.8rem;"></i>
                        <a href="{{site.links.instagram}}" target="_blank" rel="noopener" class="text-gray-500 text-sm hover:text-white transition-colors">{{site.contact.instagram}}</a>
                    </div>
                    {{/if}}
                    {{#if site.links.waze}}
                    <div class="flex items-center gap-3">
                        <i class="fa-brands fa-waze text-gold" style="font-size:0.8rem;"></i>
                        <a href="{{site.links.waze}}" target="_blank" rel="noopener" class="text-gray-500 text-sm hover:text-white transition-colors">Cómo llegar con Waze</a>
                    </div>
                    {{/if}}
                </div>
            </div>

            <!-- Horario -->
            <div>
                <h5 class="bebas text-white mb-4" style="font-size:1.2rem; letter-spacing:1px;">Horario</h5>
                <div class="flex flex-col gap-2 mb-6">
                    {{#each site.schedule}}
                    <div class="flex justify-between gap-6">
                        <span class="text-gray-500 text-sm">{{this.label}}</span>
                        <span class="text-sm {{#if this.closed}}text-danger{{else}}text-gray-300{{/if}}">{{this.value}}</span>
                    </div>
                    {{/each}}
                </div>
                <a href="/reservar" class="btn btn-gold rounded-pill" style="font-size:0.85rem;">
                    <i class="fa-solid fa-scissors me-1"></i>Reservar
                </a>
            </div>

        </div>

        <div class="border-t border-white/5 mt-12 pt-6 text-center">
            <p class="text-gray-600 text-xs">HighQuality Studio &copy; 2025 — Diseñado por <span class="text-gray-500">IM Labs</span></p>
        </div>
    </div>
</footer>

<script>
    AOS.init({ once: true, duration: 820, offset: 60 });
</script>
<script src="/js/client/index.js"></script>
