<style>
    body{
        /* fma-landing-page.jpg */
        background-image: url('/images/fma-landing-page.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }
</style>
<section class="vh-100 d-flex justify-content-center align-items-center">
    <div class="text-center">
        <img src="/images/logo-tr.png" alt="Pole Image" width="250px">
        <h1 class="fw-bold">Coming soon...</h1>
        <p class="my-3 text-gray w-75 mx-auto">Estamos mejorando el sitio, puedes seguir sacando citas aca</p>
        <a href="/reservar" class="btn btn-secondary text-uppercase fw-bold">
            <i class="fa-solid fa-scissors"></i> Reservar cita
        </a>
    </div>
</section>

<script>
    // use anime.js to animate the elements
    anime({
        targets: 'section',
        translateY: [-10, 0],
        opacity: [0, 1],
        delay: anime.stagger(100),
        easing: 'easeInOutSine'
    });
    anime({
        targets: 'img',
        rotate: [180, 0],
        opacity: [0, 1],
        delay: 500,
        easing: 'easeInOutSine'
    });
    anime({
        targets: 'h1',
        translateY: [-10, 0],
        opacity: [0, 1],
        delay: 1000,
        easing: 'easeInOutSine'
    });
    anime({
        targets: 'p',
        translateY: [-10, 0],
        opacity: [0, 1],
        delay: 1500,
        easing: 'easeInOutSine'
    });
    anime({
        targets: 'a',
        translateY: [-10, 0],
        opacity: [0, 1],
        delay: 1500,
        easing: 'easeInOutSine'
    });
</script>