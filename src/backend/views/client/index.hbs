                Ver mas
            </a>
        </div>
    </section>

    <div class="container mt-5">
        <h1 class="fw-bold">Reviews</h1>
        <hr>
    </div>
    <section class="splide" id="opinionesCarousel">
        <div class="splide__track">
              <ul class="splide__list" id="opinionesList">
              </ul>
        </div>
    </section>
    <section class="container my-5">
        <h2 class="fw-bold">Deja tu opinión</h2>
        <hr>
        <div class="bg-dark rounded-3 shadow p-3">
            <form action="/api/v1/review/test" method="post" id="formOpinion">
                <input type="number" class="form-control" name="stars" id="stars" aria-describedby="starsId" hidden/>
                <div class="d-flex justify-content-start align-items-center gap-2 mb-3">
                    <button type="button" class="btn btn-star-ranking" onclick="addStar(1, this)">
                        <i class="fa-regular fa-star"></i>
                    </button>
                    <button type="button" class="btn btn-star-ranking" onclick="addStar(2, this);">
                        <i class="fa-regular fa-star"></i>
                    </button>
                    <button type="button" class="btn btn-star-ranking" onclick="addStar(3, this);">
                        <i class="fa-regular fa-star"></i>
                    </button>
                    <button type="button" class="btn btn-star-ranking" onclick="addStar(4, this);">
                        <i class="fa-regular fa-star"></i>
                    </button>
                    <button type="button" class="btn btn-star-ranking" onclick="addStar(5, this);">
                        <i class="fa-regular fa-star"></i>
                    </button>
                </div>
                <div class="mb-3">
                    <label for="nombre" class="form-label">Nombre</label>
                    <input type="text" class="form-control" name="nombre" id="nombre" aria-describedby="nombreId" placeholder="Nombre"/>
                </div>
                <div class="mb-3">
                    <label for="opinion" class="form-label">Opiniones</label>
                    <textarea class="form-control" name="opinion" id="opinion" rows="3" placeholder="Review..."></textarea>
                </div>
                <small id="feedbackerror" class="text-danger d-block my-2"></small>
                <button type="submit" class="btn btn-success text-white">
                    <i class="fa-solid fa-paper-plane"></i> Enviar
                </button>
            </form>
        </div>
    </section>
    <section class="bg-fore p-3">
        <img src="/images/logo-tr.png" alt="Logo the HighQuality Barber" class="mx-auto d-block" width="250px">
        
        <div class="d-flex justify-content-center align-items-center gap-3 py-3">
