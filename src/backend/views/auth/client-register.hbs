<div x-data="clientRegister()"
     class="min-h-screen bg-[#141414] flex flex-col items-center justify-center px-4 py-10 safe-area-inset">

    <!-- ── Brand ── -->
    <div class="text-center mb-8 animate__animated animate__fadeIn">
        <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-white/5 border border-white/[.08] flex items-center justify-center">
            <img src="/images/simple-logo.png" alt="HighQuality" width="38" height="38" draggable="false">
        </div>
        <p class="nautigal text-gold leading-tight mb-0.5" style="font-size:1.9rem; line-height:1.1;">Tu cuenta</p>
        <h1 class="bebas text-white leading-none tracking-widest" style="font-size:3.4rem;">CREAR CUENTA</h1>
        <div class="w-10 h-px mx-auto mt-2.5 bg-gold/40 rounded-full"></div>
    </div>

    <!-- ── Shake wrapper ── -->
    <div class="w-full max-w-sm"
         :class="shake ? 'animate__animated animate__faster animate__shakeX' : ''"
         @animationend="shake = false">

        <!-- ── Card ── -->
        <div class="animate__animated animate__fadeInUp animate__faster bg-[#0d0d0d] border border-white/[.08] rounded-2xl p-7 sm:p-9">

            <!-- Error banner -->
            <div x-show="error"
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 -translate-y-1"
                 x-transition:enter-end="opacity-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-150"
                 x-transition:leave-start="opacity-100"
                 x-transition:leave-end="opacity-0"
                 class="mb-5 rounded-xl px-4 py-3.5 bg-danger/10 border border-danger/25 flex items-start gap-3">
                <i class="fa-solid fa-circle-exclamation text-danger text-sm mt-0.5 flex-shrink-0"></i>
                <p class="text-danger text-sm leading-snug" x-text="error"></p>
            </div>

            <!-- Name input -->
            <div class="mb-4">
                <div class="relative">
                    <i class="fa-solid fa-user absolute left-4 top-1/2 -translate-y-1/2 text-sm pointer-events-none transition-colors duration-200"
                       :class="focusField === 'name' ? 'text-gold' : 'text-gray-600'"></i>
                    <input
                        type="text"
                        x-model="form.name"
                        @focus="focusField = 'name'"
                        @blur="focusField = null; validateName()"
                        @input="errors.name && validateName()"
                        placeholder="Tu nombre completo"
                        autocomplete="name"
                        inputmode="text"
                        class="w-full text-white text-base placeholder-gray-600 rounded-xl pl-11 pr-4 py-4 outline-none border transition-all duration-200"
                        :class="errors.name
                            ? 'bg-danger/5 border-danger/50 ring-2 ring-danger/15'
                            : focusField === 'name'
                                ? 'bg-white/[.06] border-gold/55 ring-2 ring-gold/12'
                                : 'bg-white/[.04] border-white/[.08] hover:border-white/[.16]'">
                </div>
                <p class="text-danger text-xs mt-1.5 pl-1 leading-snug"
                   x-show="errors.name"
                   x-transition:enter="transition ease-out duration-150"
                   x-transition:enter-start="opacity-0"
                   x-transition:enter-end="opacity-100"
                   x-text="errors.name"></p>
            </div>

            <!-- Phone input -->
            <div class="mb-4">
                <div class="relative">
                    <i class="fa-solid fa-phone absolute left-4 top-1/2 -translate-y-1/2 text-sm pointer-events-none transition-colors duration-200"
                       :class="focusField === 'phone' ? 'text-gold' : 'text-gray-600'"></i>
                    <input
                        type="tel"
                        x-ref="phone"
                        inputmode="numeric"
                        pattern="\d{8}"
                        maxlength="8"
                        @focus="focusField = 'phone'"
                        @blur="focusField = null; validatePhone()"
                        @input="syncPhone($event); errors.phone && validatePhone()"
                        placeholder="Teléfono (8 dígitos)"
                        autocomplete="tel"
                        class="w-full text-white text-base placeholder-gray-600 rounded-xl pl-11 pr-4 py-4 outline-none border transition-all duration-200"
                        :class="errors.phone
                            ? 'bg-danger/5 border-danger/50 ring-2 ring-danger/15'
                            : focusField === 'phone'
                                ? 'bg-white/[.06] border-gold/55 ring-2 ring-gold/12'
                                : 'bg-white/[.04] border-white/[.08] hover:border-white/[.16]'">
                </div>
                <p class="text-danger text-xs mt-1.5 pl-1 leading-snug"
                   x-show="errors.phone"
                   x-transition:enter="transition ease-out duration-150"
                   x-transition:enter-start="opacity-0"
                   x-transition:enter-end="opacity-100"
                   x-text="errors.phone"></p>
            </div>

            <!-- Password input + strength meter -->
            <div class="mb-4">
                <div class="relative">
                    <i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-sm pointer-events-none transition-colors duration-200"
                       :class="focusField === 'password' ? 'text-gold' : 'text-gray-600'"></i>
                    <input
                        :type="showPwd ? 'text' : 'password'"
                        x-model="form.password"
                        @focus="focusField = 'password'"
                        @blur="focusField = null; validatePassword()"
                        @input="validatePassword()"
                        placeholder="Contraseña"
                        autocomplete="new-password"
                        class="w-full text-white text-base placeholder-gray-600 rounded-xl pl-11 pr-12 py-4 outline-none border transition-all duration-200"
                        :class="errors.password
                            ? 'bg-danger/5 border-danger/50 ring-2 ring-danger/15'
                            : focusField === 'password'
                                ? 'bg-white/[.06] border-gold/55 ring-2 ring-gold/12'
                                : 'bg-white/[.04] border-white/[.08] hover:border-white/[.16]'">
                    <button type="button" @click="showPwd = !showPwd"
                            class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gold transition-colors duration-150 p-1 touch-manipulation">
                        <i class="fa-solid text-sm" :class="showPwd ? 'fa-eye-slash' : 'fa-eye'"></i>
                    </button>
                </div>

                <!-- Password strength meter -->
                <div x-show="form.password.length > 0" x-transition class="mt-2.5 px-0.5">
                    <div class="flex gap-1 mb-1">
                        <template x-for="i in 4" :key="i">
                            <div class="h-1 flex-1 rounded-full transition-all duration-300"
                                 :class="i <= strength ? strengthColor : 'bg-white/[.08]'"></div>
                        </template>
                    </div>
                    <p class="text-xs transition-colors duration-200" :class="strengthTextColor" x-text="strengthLabel"></p>
                </div>

                <p class="text-danger text-xs mt-1.5 pl-1 leading-snug"
                   x-show="errors.password"
                   x-transition:enter="transition ease-out duration-150"
                   x-transition:enter-start="opacity-0"
                   x-transition:enter-end="opacity-100"
                   x-text="errors.password"></p>
            </div>

            <!-- Confirm password -->
            <div class="mb-7">
                <div class="relative">
                    <i class="fa-solid fa-shield-check absolute left-4 top-1/2 -translate-y-1/2 text-sm pointer-events-none transition-colors duration-200"
                       :class="focusField === 'confirm' ? 'text-gold' : 'text-gray-600'"></i>
                    <input
                        :type="showConfirm ? 'text' : 'password'"
                        x-model="form.confirm"
                        @focus="focusField = 'confirm'"
                        @blur="focusField = null; validateConfirm()"
                        @input="errors.confirm && validateConfirm()"
                        @keydown.enter="submit()"
                        placeholder="Confirmar contraseña"
                        autocomplete="new-password"
                        class="w-full text-white text-base placeholder-gray-600 rounded-xl pl-11 pr-12 py-4 outline-none border transition-all duration-200"
                        :class="errors.confirm
                            ? 'bg-danger/5 border-danger/50 ring-2 ring-danger/15'
                            : form.confirm && !errors.confirm
                                ? 'bg-success/5 border-success/40 ring-2 ring-success/10'
                                : focusField === 'confirm'
                                    ? 'bg-white/[.06] border-gold/55 ring-2 ring-gold/12'
                                    : 'bg-white/[.04] border-white/[.08] hover:border-white/[.16]'">
                    <button type="button" @click="showConfirm = !showConfirm"
                            class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gold transition-colors duration-150 p-1 touch-manipulation">
                        <i class="fa-solid text-sm" :class="showConfirm ? 'fa-eye-slash' : 'fa-eye'"></i>
                    </button>
                </div>
                <p class="text-danger text-xs mt-1.5 pl-1 leading-snug"
                   x-show="errors.confirm"
                   x-transition:enter="transition ease-out duration-150"
                   x-transition:enter-start="opacity-0"
                   x-transition:enter-end="opacity-100"
                   x-text="errors.confirm"></p>
            </div>

            <!-- CTA -->
            <button type="button" @click="submit()" :disabled="loading || success"
                    class="w-full rounded-full py-4 text-base font-semibold tracking-wide transition-all duration-200 active:scale-[.97] touch-manipulation select-none"
                    :class="success
                        ? 'bg-success text-white cursor-default'
                        : loading
                            ? 'bg-gold/60 text-[#141414]/50 cursor-not-allowed'
                            : 'bg-gold text-[#141414] hover:brightness-110 cursor-pointer'">
                <span x-show="!loading && !success" class="flex items-center justify-center gap-2">
                    Crear cuenta <i class="fa-solid fa-user-plus text-sm"></i>
                </span>
                <span x-show="loading" class="flex items-center justify-center gap-2">
                    <i class="fa-solid fa-spinner fa-spin"></i> Creando cuenta...
                </span>
                <span x-show="success" class="flex items-center justify-center gap-2">
                    <i class="fa-solid fa-check"></i> ¡Cuenta creada!
                </span>
            </button>

        </div>
    </div>

    <!-- Login link -->
    <div class="text-center mt-7">
        <p class="text-gray-600 text-sm">
            ¿Ya tienes cuenta?
            <a href="/ingresar"
               class="text-gold hover:brightness-110 font-medium ml-1 transition-all duration-200">
                Ingresar <i class="fa-solid fa-arrow-right text-xs ml-0.5"></i>
            </a>
        </p>
        <a href="/" class="text-gray-700 text-xs hover:text-gray-500 mt-2 inline-block transition-colors">
            <i class="fa-solid fa-house mr-1"></i> Volver al inicio
        </a>
    </div>

</div>
